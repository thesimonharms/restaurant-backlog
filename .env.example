# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# DeepSeek API Key (used via baochuan crate)
DEEPSEEK_API_KEY=your_deepseek_key_here

# PostgreSQL connection string
DATABASE_URL=postgres://backlog:backlog_pass@localhost:5432/restaurant_backlog

# Allowlist: comma-separated Telegram user IDs
# Leave empty/unset to allow everyone.
# Example: ALLOWED_USER_IDS=12345678,98765432
ALLOWED_USER_IDS=
